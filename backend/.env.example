# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopwise_dev
DB_USER=shopwise_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=24h

# API Configuration
API_BASE_URL=http://localhost:3000/api/v1

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging
LOG_LEVEL=info
LOG_FILE=logs/shopwise.log

# Analysis Configuration
EXPIRY_RISK_WINDOW_DAYS=14
STOCK_ANALYSIS_PERIOD_DAYS=30
SLOW_MOVING_THRESHOLD_DAYS=30
DEFAULT_TARGET_STOCK_DAYS=7

# Notification Configuration
ENABLE_PUSH_NOTIFICATIONS=false
DAILY_SUMMARY_TIME=18:00

# Security
BCRYPT_SALT_ROUNDS=10
