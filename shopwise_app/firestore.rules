rules_version = '2';

// ShopWise Firestore Security Rules
//
// Data model (prototype):
//   users/{uid}                 – the user's profile
//   shops/{uid}                 – the shop, keyed by the OWNER's Firebase UID
//   shops/{uid}/products/{id}   – products
//   shops/{uid}/batches/{id}    – stock batches
//   shops/{uid}/invoices/{id}   – sales invoices
//
// Because the shop document id equals the owner's UID, a single check
// (request.auth.uid == shopId) guarantees that a shopkeeper can only ever
// read or write their OWN shop's data — including every nested subcollection.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only access their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Shops are keyed by the owner's UID. Only the owner can access their shop.
    match /shops/{shopId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == shopId;

      // Every nested document (products, batches, invoices, ...) belongs to the
      // shop owner. The recursive wildcard + the uid == shopId check keeps each
      // shop's data fully isolated from every other shop.
      match /{document=**} {
        allow read, write: if request.auth != null
                            && request.auth.uid == shopId;
      }
    }
  }
}
