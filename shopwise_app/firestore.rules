rules_version = '2';

// ShopWise Firestore Security Rules
//
// Data model:
//   users/{uid}                   – user profile
//   shops/{uid}                   – shop, keyed by owner Firebase UID
//   shops/{uid}/products/{id}     – products
//   shops/{uid}/batches/{id}      – stock batches
//   shops/{uid}/invoices/{id}     – sales invoices
//   shops/{uid}/customers/{id}    – customers / baki khata
//   shops/{uid}/categories/{id}   – product categories
//
// Because the shop document id equals the owner's UID, a single
// `request.auth.uid == shopId` check in the recursive wildcard rule keeps
// every shop's data fully isolated — no user can read or write another
// shop's subcollections.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only access their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Shops are keyed by the owner's UID. Only the owner can access their shop.
    match /shops/{shopId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == shopId;

      // Every nested document (products, batches, invoices, ...) belongs to the
      // shop owner. The recursive wildcard + the uid == shopId check keeps each
      // shop's data fully isolated from every other shop.
      match /{document=**} {
        allow read, write: if request.auth != null
                            && request.auth.uid == shopId;
      }
    }
  }
}
